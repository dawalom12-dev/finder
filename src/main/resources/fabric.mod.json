{
  "schemaVersion": 1,
  "id": "packetlogger",
  "version": "${version}",
  "name": "Packet Logger",
  "description": "Logs server connection events and retrieves backend server IPs via BungeeCord plugin messaging.",
  "authors": ["You"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.example.packetlogger.PacketLoggerClient"
    ]
  },
  "mixins": [
    "packetlogger.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
